    {
      "name": "🟢 Scenario 1: Happy Path — Complete Wedding Brief",
      "description": "All 5 required fields in one message. Agent skips clarification and generates quote. SME approves → EXECUTED.",
      "item": [
        {
          "name": "1.1 Create Wedding Job",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "pm.test('State is IDLE', () => pm.expect(data.state).to.eql('IDLE'));",
                  "pm.collectionVariables.set('s1_job_id', data.job_id);",
                  "pm.collectionVariables.set('job_id', data.job_id);",
                  "console.log('S1 Job ID:', data.job_id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"business_id\": \"biz_vendor_001\",\n  \"business_type\": \"event_vendor\",\n  \"client_name\": \"Sarah Adeyemi\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/jobs", "host": ["{{baseUrl}}"], "path": ["jobs"] }
          },
          "response": []
        },
        {
          "name": "1.2 Send Complete Wedding Brief",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.test('State is AWAITING_HUMAN_APPROVAL', () => pm.expect(data.state).to.eql('AWAITING_HUMAN_APPROVAL'));",
                  "pm.test('Quote is not null', () => pm.expect(data.quote).to.not.be.null);",
                  "pm.test('No missing required fields', () => pm.expect(data.missing_required_fields).to.have.lengthOf(0));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message_text\": \"Good afternoon! I am planning my daughter's wedding, we are expecting about 150 guests. It will hold on the 14th of next month, outdoors at our family compound in Lekki. Budget is around 3 million naira, we want it done nicely but not over the top.\",\n  \"received_at\": \"2026-09-02T12:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/jobs/{{s1_job_id}}/messages",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{s1_job_id}}", "messages"]
            }
          },
          "response": []
        },
        {
          "name": "1.3 Get Draft Quote",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.test('Quote status is draft', () => pm.expect(data.status).to.eql('draft'));",
                  "pm.test('Has line items', () => pm.expect(data.line_items).to.be.an('array').that.is.not.empty);",
                  "pm.test('Total > 0', () => pm.expect(data.total).to.be.above(0));",
                  "console.log('Quote total:', data.total, data.currency);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{s1_job_id}}/quote",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{s1_job_id}}", "quote"]
            }
          },
          "response": []
        },
        {
          "name": "1.4 Approve & Send Quote",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.test('State is EXECUTED', () => pm.expect(data.state).to.eql('EXECUTED'));",
                  "pm.test('Quote status is SENT', () => pm.expect(data.quote.status).to.eql('SENT'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"approved_by\": \"sme_owner_david\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/jobs/{{s1_job_id}}/approve_quote",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{s1_job_id}}", "approve_quote"]
            }
          },
          "response": []
        }
      ]
    },
