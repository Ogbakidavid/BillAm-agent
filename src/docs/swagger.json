{
  "openapi": "3.0.3",
  "info": {
    "title": "BillAm Agent API",
    "version": "2.0.0",
    "description": "Job-oriented REST API for BillAm Agent — autonomous SME quoting & clarification engine. Powered by Strands Agents SDK + Claude Sonnet 4.5."
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Returns server status and timestamp.",
        "responses": {
          "200": {
            "description": "Server healthy"
          }
        }
      }
    },
    "/jobs": {
      "get": {
        "summary": "List All Jobs",
        "description": "Returns all jobs in the in-memory store. Useful for the SME dashboard overview page.",
        "responses": {
          "200": {
            "description": "Array of all job objects"
          }
        }
      },
      "post": {
        "summary": "Create Job",
        "description": "Creates a new job session for a specific business. Returns the job in IDLE state.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["business_id", "business_type"],
                "properties": {
                  "business_id": {
                    "type": "string",
                    "example": "biz_vendor_001"
                  },
                  "business_type": {
                    "type": "string",
                    "enum": ["caterer", "tailor", "event_vendor", "photographer", "event_planner", "equipment_rental"],
                    "example": "event_vendor"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Job created successfully in IDLE state"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/jobs/{id}": {
      "get": {
        "summary": "Get Job Details",
        "description": "Retrieves the full job object including state, messages, extracted fields, and quote.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Job ID"
          }
        ],
        "responses": {
          "200": { "description": "Full job object returned" },
          "404": { "description": "Job not found" }
        }
      }
    },
    "/jobs/{id}/messages": {
      "post": {
        "summary": "Send Client Message",
        "description": "Appends a client message to the job and triggers the Strands Agent reasoning loop. The agent autonomously extracts brief data, generates clarifying questions, or produces a quote draft. Valid inbound states: IDLE, CLARIFYING, FAILED_RETRY. SME messages can be sent at any state.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["message_text", "received_at"],
                "properties": {
                  "message_text": {
                    "type": "string",
                    "example": "Good afternoon! I am planning my daughter's wedding, we are expecting about 150 guests. It will hold on the 14th of next month, outdoors at our family compound in Lekki. Budget is around 3 million naira."
                  },
                  "received_at": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2026-09-02T12:00:00.000Z"
                  },
                  "sender": {
                    "type": "string",
                    "enum": ["client", "sme"],
                    "default": "client",
                    "description": "Defaults to client. Use 'sme' for SME-injected messages that should not trigger agent loop."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Agent loop completed. Returns updated job. Possible outcome states: CLARIFYING, NEEDS_SME_INPUT, AWAITING_HUMAN_APPROVAL, FAILED_RETRY"
          },
          "409": { "description": "Invalid state — cannot receive messages in current state" }
        }
      }
    },
    "/jobs/{id}/quote": {
      "get": {
        "summary": "Get Draft Quote",
        "description": "Returns the agent-generated draft quote (line items, contingencies, totals). Only available when a quote exists.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Draft quote returned with full line items and totals" },
          "404": { "description": "No quote available for this job" }
        }
      },
      "patch": {
        "summary": "Edit Draft Quote",
        "description": "Allows the SME to modify line items and notes before approving. Only valid in AWAITING_HUMAN_APPROVAL state. Does not send the quote.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "line_items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": { "type": "string" },
                        "quantity": { "type": "number" },
                        "unit_price": { "type": "number" },
                        "total": { "type": "number" }
                      }
                    },
                    "example": [
                      { "name": "Venue Decor", "quantity": 1, "unit_price": 450000, "total": 450000 }
                    ]
                  },
                  "notes": {
                    "type": "string",
                    "example": "Applied 10% corporate discount after SME review"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Quote updated. Subtotal and total recalculated." },
          "409": { "description": "State must be AWAITING_HUMAN_APPROVAL to edit quote" }
        }
      }
    },
    "/jobs/{id}/approve_quote": {
      "post": {
        "summary": "Approve and Send Quote",
        "description": "The only action that can send a quote to the simulated client chat. SME must explicitly call this endpoint. Transitions job to EXECUTED.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["approved_by"],
                "properties": {
                  "approved_by": {
                    "type": "string",
                    "example": "sme_owner_david"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Quote approved and sent. State: EXECUTED, quote status: SENT." },
          "409": { "description": "Approval not allowed — job must be in AWAITING_HUMAN_APPROVAL" }
        }
      }
    },
    "/jobs/{id}/missing_fields": {
      "get": {
        "summary": "Get Missing Fields",
        "description": "Returns the list of unresolved required fields. Intended for use when job is in NEEDS_SME_INPUT state.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Missing fields list, summary, and clarification round returned" }
        }
      }
    },
    "/jobs/{id}/manual_input": {
      "post": {
        "summary": "Submit Manual SME Input",
        "description": "Allows the SME to supply unresolved required field values and re-trigger the agent reasoning loop. Only valid in NEEDS_SME_INPUT state.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["supplied_fields"],
                "properties": {
                  "supplied_fields": {
                    "type": "object",
                    "example": {
                      "guest_count": 150,
                      "event_date": "2026-11-20"
                    }
                  },
                  "source": {
                    "type": "string",
                    "example": "SME obtained details directly via phone call"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Manual input accepted. Agent loop re-executed." },
          "409": { "description": "State must be NEEDS_SME_INPUT to submit manual input" }
        }
      }
    },
    "/jobs/{id}/retry": {
      "post": {
        "summary": "Retry Failed Job",
        "description": "Re-invokes the agent loop for a job in FAILED_RETRY state. Preserves existing messages, extracted fields, and clarification history.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Retry initiated. State transitions to REASONING." },
          "409": { "description": "State must be FAILED_RETRY to retry" }
        }
      }
    }
  }
}
